{
	"name": "brigadir",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.0.0",
	"packageManager": "pnpm@11.19.0",
	"scripts": {
		"prepare": "cd .. && husky electron/.husky",
		"format:staged": "lint-staged --cwd .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"dev:secondary": "pnpm build:services && node scripts/start-desktop.mjs --dev --secondary",
		"dev": "pnpm build:services && node scripts/start-desktop.mjs --dev",
		"start": "pnpm build && node scripts/start-desktop.mjs",
		"start:secondary": "pnpm build && node scripts/start-desktop.mjs --secondary",
		"build": "pnpm --filter @brigadir/desktop build && pnpm build:services",
		"typecheck": "tsc --noEmit && tsc -p packages/core/tsconfig.json --noEmit",
		"test": "pnpm build:services && vitest run",
		"test:desktop": "pnpm build && node scripts/test-e2e.mjs full",
		"test:smoke": "node scripts/test-e2e.mjs smoke",
		"test:area": "node scripts/test-e2e.mjs area",
		"test:full": "pnpm build && node scripts/test-e2e.mjs full",
		"check": "pnpm typecheck && pnpm test && pnpm build",
		"build:services": "node scripts/build-services.mjs",
		"dist:mac": "node scripts/dist.mjs",
		"dist:linux": "node scripts/dist.mjs --linux",
		"dist:check": "node scripts/check-dist.mjs"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"electron-builder": "26.15.3",
		"esbuild": "0.25.12",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"typescript": "~5.9.3",
		"vitest": "^4.0.0"
	}
}
